{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Bevy (GaranStrartegyChuss)",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "build",
                    "--bin",
                    "GaranStrartegyChuss"
                ],
                "filter": {
                    "name": "GaranStrartegyChuss",
                    "kind": "bin"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}",
            "env": {
                "RUST_BACKTRACE": "1",
                "PATH": "${workspaceFolder}\\target\\debug;${workspaceFolder}\\target\\debug\\deps;${env:PATH}"
            },
            "sourceLanguages": [
                "rust"
            ]
        }
    ]
}